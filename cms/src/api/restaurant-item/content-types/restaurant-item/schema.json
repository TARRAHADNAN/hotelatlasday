{
  "kind": "collectionType",
  "collectionName": "restaurant_items",
  "info": {
    "singularName": "restaurant-item",
    "pluralName": "restaurant-items",
    "displayName": "Plat Restaurant",
    "description": "Plats et boissons du restaurant"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "category": {
      "type": "enumeration",
      "enum": ["entrees", "plats", "desserts", "boissons", "petits_dejeuners"],
      "default": "plats",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "description": {
      "type": "text",
      "maxLength": 300,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "min": 0,
      "required": true
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "dietary": {
      "type": "json",
      "default": []
    },
    "order": {
      "type": "integer",
      "default": 0
    },
    "available": {
      "type": "boolean",
      "default": true
    }
  }
}

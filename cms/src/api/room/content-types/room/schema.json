{
  "kind": "collectionType",
  "collectionName": "rooms",
  "info": {
    "singularName": "room",
    "pluralName": "rooms",
    "displayName": "Chambre",
    "description": "Chambres et suites de l'hôtel"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "maxLength": 100,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "description": {
      "type": "richtext",
      "required": true,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "shortDescription": {
      "type": "text",
      "required": true,
      "maxLength": 250,
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "category": {
      "type": "enumeration",
      "enum": ["standard", "deluxe", "suite", "premium"],
      "default": "standard",
      "required": true
    },
    "capacity": {
      "type": "component",
      "repeatable": false,
      "component": "room.capacity",
      "required": true
    },
    "surface": {
      "type": "integer",
      "min": 10,
      "max": 300,
      "required": true
    },
    "priceFrom": {
      "type": "decimal",
      "min": 0
    },
    "ezeeRoomCode": {
      "type": "string",
      "maxLength": 50
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": ["images"]
    },
    "gallery": {
      "type": "media",
      "multiple": true,
      "allowedTypes": ["images"]
    },
    "amenities": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::amenity.amenity",
      "inversedBy": "rooms"
    },
    "featured": {
      "type": "boolean",
      "default": false,
      "required": true
    },
    "order": {
      "type": "integer",
      "default": 0,
      "required": true
    },
    "seo": {
      "type": "component",
      "repeatable": false,
      "component": "shared.seo"
    }
  }
}
